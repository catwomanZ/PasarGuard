# Rendered by /opt/entrypoint.sh. Placeholders are @@NAME@@.
#
# Railway terminates TLS at its edge and hands us plain HTTP on one port. The
# panel wants to sit behind a reverse proxy (it says so itself when started
# without its own certificate), so nginx is the only thing on that port and
# everything else stays on loopback.
worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 20m;

    # WebSocket tunnels are idle most of the time; the default 60s kills them.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # One line per panel request, holding nothing but the Host header. Reads as
    # noise; it is the raw material autohost.py uses to work out which address
    # this panel is really being reached on. Written to a file, never to stdout,
    # because it is machinery and not something a person wants to scroll past.
    log_format cwhost '$host';

    server {
        listen @@HTTP_PORT@@;
        listen [::]:@@HTTP_PORT@@;
        server_name _;

        # Railway's health probe. Forwarded so it also proves the panel is up.
        location = /healthz {
            access_log off;
            proxy_pass http://127.0.0.1:@@PANEL_PORT@@/health;
        }

        # --- the VLESS WebSocket inbound -------------------------------------
        location @@TUNNEL_PATH@@ {
            proxy_pass http://127.0.0.1:@@INBOUND_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # --- everything else is the panel ------------------------------------
        # Dashboard, /api, /statics, /sub -- one upstream, URI passed through
        # untouched so the panel's own route table decides.
        location / {
            proxy_pass http://127.0.0.1:@@PANEL_PORT@@;
            access_log /dev/stdout;
            access_log /tmp/cw_host.log cwhost;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 300s;
        }
    }
}
